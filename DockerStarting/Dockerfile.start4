# syntax=docker/dockerfile:1
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENV=.venv

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        locales \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh -s -- --yes

WORKDIR /workspace
COPY . /workspace

# Create a virtual environment but never activate it.
RUN uv sync

CMD ["pytest", "-c", "DockerStarting/pytest.ini", "DockerStarting/tests", "-q"]
